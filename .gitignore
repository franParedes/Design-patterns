## A streamlined .gitignore for modern .NET projects
## including temporary files, build results, and
## files generated by popular .NET tools.

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet Packages
*.nupkg
# NuGet Symbol Packages
*.snupkg

# dotenv environment variables file
.env

# ASP.NET Core - Configuraciones locales (¡Muy importante para seguridad!)
appsettings.Development.json
appsettings.Local.json
secrets.json

# Entornos de desarrollo y editores (Visual Studio, VS Code, Rider)
.vs/
.vscode/
.idea/
*.user
*.userosscache
*.sln.docstates
*.suo
*.rsuser

# Frontend y Dependencias de cliente (React, TypeScript, pnpm, npm)
node_modules/
dist/
build/
.npm/
.pnpm-store/

# Others
~$*
*~
CodeCoverage/

# MSBuild Binary and Structured Log
*.binlog

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml

# Archivos del Sistema Operativo (Windows / macOS)
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db